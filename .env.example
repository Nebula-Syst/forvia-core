# Optional for local dev — every value below has a working default. Copy to ".env" to change any.
# The full description of each setting lives in Forvia's own .env.example; this lists the ones
# forvia-core reads.

# Public URL of the app (Forvia's web container). Passkeys are bound to it.
# ORIGIN=http://localhost:8080

# Shared with Forvia's api — must be the same value in both repos' .env.
# INTERNAL_SECRET=pick-something-long-and-random

# Postgres (the db container lives in this repo's dev stack). Forvia's api uses the same values.
# POSTGRES_USER=forvia
# POSTGRES_PASSWORD=forvia
# POSTGRES_DB=forvia
# Host port for a local SQL client (127.0.0.1 only).
# DB_HOST_PORT=5432

# Port core-api listens on inside the network, and the host port for debugging (127.0.0.1 only).
# CORE_PORT=3000
# CORE_HOST_PORT=3001

# Accounts & admin
# ADMIN_UIDS=youruserid
# INVITE_ONLY=1
# ALLOW_GUEST=0
# ALLOW_REGISTER=1
# SESSION_DAYS=90

# Activity log
# AUDIT_LOG=0
# AUDIT_MAX=5000
# AUDIT_DAYS=90
# AUDIT_IP=off

# Push / mail
# VAPID_SUBJECT=mailto:you@example.com
# SMTP_HOST= SMTP_PORT= SMTP_SECURE= SMTP_USER= SMTP_PASS= SMTP_FROM=

# Ads & analytics (all off unless set)
# GOOGLE_ANALYTICS_ID=
# ADSENSE_CLIENT_ID= ADSENSE_SLOT_BANNER= ADSENSE_SLOT_FEED=
# ADMOB_APP_ID= ADMOB_REWARDED_UNIT_ID=
# LANDING_ORIGINS=
# BOX_LOCATION_MODE=search
